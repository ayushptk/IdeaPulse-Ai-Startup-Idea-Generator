# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.

NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# Backend API URL — Priority: Render > localhost
# ──────────────────────────────────────────────

# PRODUCTION (Render) — active by default
API_URL=

# Shared secret for server-to-server calls — must match backend INTERNAL_API_KEY
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# Client-side API URL (exposed to browser)
NEXT_PUBLIC_API_URL=

# ── LOCAL DEVELOPMENT FALLBACKS (uncomment when running backend locally) ──
# API_URL=http://127.0.0.1:8000/api/v1
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
